# .env 範本 —— 複製成 .env 再填值：   cp .env.example .env   （Windows: Copy-Item .env.example .env）
# .env 已在 .gitignore，不要 commit；這份 .env.example 不放任何真實值。
# 標「必填」的沒設，docker compose up 會直接報錯。改完要重啟對應服務。
#
# 產生隨機金鑰（PowerShell）：
#   -join ((1..24) | ForEach-Object { '{0:x2}' -f (Get-Random -Maximum 256) })    # 48 字元
# 或：openssl rand -hex 24

# ── 資料庫（必填）──────────────────────────────────────────────
# MySQL 容器第一次啟動時用這兩組密碼建立帳號（apiuser）。已經有 ./mysql-data 的環境，
# 改這裡的值不會改到資料庫裡的密碼 —— 要同步改 MySQL 帳號，或砍掉 ./mysql-data 重建。
MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=

# ── API 安全（必填）────────────────────────────────────────────
# /report_security_anomaly 的服務金鑰。呼叫端要帶標頭 X-Service-Token: <這個值>。
# 至少 32 字元；只交給 Gateway / Policy Engine 這類後端服務，不要給 App 或瀏覽器。
ANOMALY_SERVICE_TOKEN=

# Node-RED 編輯器登入密碼（帳號固定 admin，網址 http://localhost:1880，只綁本機）。
# 至少 16 字元；沒設或太短 Node-RED 會拒絕啟動。
NODE_RED_ADMIN_PASSWORD=

# ── 瀏覽器 CORS（選填）─────────────────────────────────────────
# 允許從這些網站的頁面呼叫 API，逗號分隔的完整 origin，例如 https://app.example.com
# localhost / 127.0.0.1 的任意 port 預設已允許（Flutter Web 開發用）。留空 = 只允許本機。
CORS_ORIGINS=

# ── 訪客 QR（選填）─────────────────────────────────────────────
# 訪客手機要打得開的訪客頁網址。留空 = 用 App 連 API 的那個 host（只限同區網）。
# 對外開放請填 HTTPS，例如 https://iota.example.com/guest
GUEST_QR_BASE_URL=

# ── 推播：alert-service（選填，沒設就只走 MQTT）──────────────────
# ntfy：手機裝 ntfy App 訂閱這個 topic。公開 ntfy.sh 的 topic 知道名字的人都能訂閱，不要外流。
NTFY_URL=https://ntfy.sh
NTFY_TOPIC=
# 自架或私有 topic 才需要
NTFY_TOKEN=
# Telegram：找 @BotFather 建 bot 拿 token；chat_id 先對 bot 傳一則訊息，
# 再開 https://api.telegram.org/bot<TOKEN>/getUpdates 看 message.chat.id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── OTA 韌體下載（必填）────────────────────────────────────────
# ESP32 直接對這個位址發 HTTP 下載 .bin，必須是 ESP32 連得到的區網 IP，
# 要跟韌體 secrets.h 的 MQTT_BROKER 同一台機器。換網路／換機器只改這裡。
OTA_HOST=

# ── MQTT 帳號密碼 ──────────────────────────────────────────────
# 由負責 MQTT 的人管理，這裡先不列；認證設定一併提供時再補進這份範本。
# docker compose 需要的 MQTT_SERVER_PASSWORD 等值，跑 config/gen_mqtt_users.ps1 會自動產生並寫進 .env。

# 另外：帳本橋接的 LEDGER_WORKER_TOKEN（至少 32 字元）放在獨立的 .ledger.env，
# 由 docker-compose.ledger.yml 載入，不在這個檔案裡。
